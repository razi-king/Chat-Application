{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd ChatAppBackend && .\\mvnw.cmd -q -B spring-boot:run"
      ],
      "port": 8080
    },
    {
      "name": "frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd chat-frontend && npm run dev:stable"
      ],
      "port": 3000
    },
    {
      "name": "frontend-prod",
      "runtimeExecutable": "cmd",
      "runtimeArgs": [
        "/c",
        "cd chat-frontend && npm start"
      ],
      "port": 3000
    }
  ]
}